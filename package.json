{
  "name": "trading-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "engine"
  ],
  "scripts": {
    "dev": "npm run generate --workspace=@algotrader/db && next dev",
    "build": "npm run generate --workspace=@algotrader/db && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run migrate --workspace=@algotrader/db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@algotrader/db"
  },
  "dependencies": {
    "@algotrader/db": "*",
    "@algotrader/shared-types": "*",
    "@algotrader/strategy-kernel": "*",
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.0",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^0.383.0",
    "next": "^16.2.1",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.7",
    "uuid": "^10.0.0",
    "yahoo-finance2": "^3.14.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4"
  }
}
