# Copy to .env (git-ignored, never commit real values — see
# .claude/agents/security-auditor.md).

# Local dev (docker-compose Postgres): the same URL works for both.
DATABASE_URL="postgresql://algotrader:algotrader@localhost:5432/algotrader"
DIRECT_URL="postgresql://algotrader:algotrader@localhost:5432/algotrader"

# Neon (production, e.g. in Vercel's Environment Variables):
#   DATABASE_URL = the "Pooled connection" string from Neon's dashboard
#                   (add ?pgbouncer=true&connect_timeout=15 if Neon doesn't
#                   already include it) — this is what the app uses at runtime.
#   DIRECT_URL   = the "Direct connection" string — used only by
#                   `prisma migrate deploy`, never at runtime.
# See packages/db/prisma/schema.prisma for why both exist.

# Non-negotiable (CLAUDE.md #1): defaults to false everywhere. Only a human,
# in the live deployment's own environment config, may ever set this true.
LIVE_TRADING_ENABLED=false

# Stocks — Alpaca. Paper and live use the same key shape, different base URL;
# see engine/src/broker-adapters/alpaca.ts.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_BASE_URL="https://paper-api.alpaca.markets"

# Crypto — used for live market data only. There is no real paper-trading
# account on these exchanges, so paper crypto trading runs through
# engine/src/broker-adapters/simulated.ts against real prices instead.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Indian equities (NSE) — Dhan. Same "paper never touches the real broker"
# shape as crypto: Dhan's own Sandbox has flat-price fills and no live
# quotes, so paper mode also runs through simulated.ts, fed by
# engine/src/market-data/dhan.ts's real prices. Only live mode uses
# DhanBrokerAdapter. See docs/ARCHITECTURE.md for the full auth/IP setup.
#
# DHAN_CLIENT_ID: your numeric Dhan client ID (visible on web.dhan.co).
# DHAN_ACCESS_TOKEN: generate ONE via web.dhan.co -> My Profile -> Access
#   DhanHQ APIs. Valid 24h; the engine renews it periodically via
#   DhanBrokerAdapter.renewToken() as long as the process stays running, but
#   a restart after >24h down needs a freshly generated token pasted here.
#   This app never automates minting a brand-new token — that requires
#   either an interactive browser login or your trading PIN + TOTP, which is
#   a bigger secret than this app should ever hold.
# DHAN_PRODUCT_TYPE: "INTRADAY" (MIS, default) or "CNC" (delivery).
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_PRODUCT_TYPE="INTRADAY"

# Order placement/modification/cancellation on Dhan require a static IP
# whitelisted on your account (SEBI requirement) — register the box running
# engine/ at web.dhan.co or via POST /v2/ip/setIP before enabling live
# trading. A non-whitelisted IP fails with Dhan error DH-905. Historical
# data and account-info calls do NOT need this.
